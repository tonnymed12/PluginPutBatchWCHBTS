<mvc:View 
xmlns:mvc="sap.ui.core.mvc" 
xmlns="sap.m" 
xmlns:l="sap.ui.layout" 
xmlns:f="sap.ui.layout.form" 
xmlns:core="sap.ui.core" 
xmlns:ndc="sap.ndc"
xmlns:html="http://www.w3.org/1999/xhtml" 
controllerName="serviacero.custom.plugins.zpluginPutBatchWCHBTS.zpluginPutBatchWCHBTS.controller.MainView" width="100%" height="100%">
		
       <Panel
                id="idPluginPanel"
                width="100%"
                height="100%"
                expandable="false"
                expanded="false"
                accessibleRole="Region"
                backgroundDesign="Transparent"
                class="sapUiNoContentPadding">

            <!-- header -->
            <HBox width="97%" class="sapUiSmallMarginBottom" alignItems="Center">
              <MessageStrip text="{i18n>scannerReady}" type="Information" showIcon="true"
                customIcon="sap-icon://bar-code" class="sapUiSmallMarginTop sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" />
                <Label text="{i18n>Barcode}" class="sapUiSmallMarginEnd"/>
                <Input id="scanInput" submit=".onBarcodeSubmit" liveChange=".onScanLiveupdate" class="sapUiSmallMarginEnd sapUiSmallMarginBeginEnd" width="300px"/>
                <ndc:BarcodeScannerButton
                    id="sampleBarcodeScannerButton"
                    scanSuccess="onScanSuccess"
                    scanFail="onScanError"
                    inputLiveUpdate="onScanLiveupdate"
                    dialogTitle="{i18n>BarcodeScanner}"
                    class="sapUiMediumMarginBegin sapUiSmallMarginEnd"
                    visible="false"
                />
            </HBox>

            <!-- Resumen de orden -->
            <HBox width="97%" justifyContent="Center" class="sapUiSmallMarginTop sapUiSmallMarginBeginEnd">
            <Table busyIndicatorDelay="5" id="idSummaryTable" items="{orderSummary>/ITEMS}"
                class="sapUiSmallMarginTop" width="100%" alternateRowColors="true">
                <headerToolbar>
                    <Toolbar >
                        <Title text="{i18n>orderSummary}"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column width="20%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>materialCode}" />
                    </Column>
                    <Column width="30%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>descripcionMaterial}" />
                    </Column>
                    <Column width="5%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>UOM}"  />
                    </Column>
                    <Column width="15%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>cantidadNecesaria}" />
                    </Column>
                    <Column width="15%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>cantidadConsumida}" />
                    </Column>
                    <Column width="10%" hAlign="Left" vAlign="Middle">
                        <Text text="{i18n>cantidadEscaneada}" />
                    </Column>
                    <Column width="10%" hAlign="Center" vAlign="Middle">
                        <Text text="{i18n>cantidadPendiente}"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{orderSummary>material}" />
                            <Text text="{orderSummary>descripcion}" />
                            <Text text="{orderSummary>uom}"/>
                            <Text text="{orderSummary>cantidadNecesaria}" />
                            <Text text="{orderSummary>cantidadConsumida}" />
                            <Text text="{orderSummary>cantidadEscaneada}" />
                            <Text text="{orderSummary>cantidadPendiente}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            </HBox> 

            <!-- tabla de lotes -->
            <HBox width="97%" justifyContent="Center" class="sapUiSmallMarginTop sapUiSmallMarginBeginEnd">
            <Table busyIndicatorDelay="5" id="idSlotTable" items="{/ITEMS}"
                class="sapUiSmallMarginTop" width="100%" alternateRowColors="true">
                <headerToolbar>
                    <Toolbar >
                        <Title text="{i18n>Items} ({= ${/ITEMS}.length})" />
                        <ToolbarSpacer />
                        <Button id="refreshBoton" text="{i18n>refresh}" press=".onPressRefresh" 
                        width="100px" class="sapUiSmallMarginBeginEnd" icon="sap-icon://refresh" type="Attention"/>
                        <Button id="clearButton" text="{i18n>clear}" press=".onPressClear" 
                        width="100px" class="sapUiSmallMarginBeginEnd" icon="sap-icon://clear-all" type="Reject"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column width="30%" hAlign="Left" vAlign="Middle" visible="false">
                        <Text text="{i18n>Slot}" visible="false" />
                    </Column>
                    <Column width="30%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>materialCode}" />
                    </Column>
                    <Column width="30%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>loteCode}"  />
                    </Column>
                    <Column width="15%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>loteQty}" />
                    </Column>
                    <Column width="15%" hAlign="Left" vAlign="Middle" >
                        <Text text="{i18n>secuenciaCode}" />
                    </Column>
                    <Column width="60%" hAlign="Left" vAlign="Middle" visible="false">
                        <Text text="{i18n>Value}" visible="false" />
                    </Column>
                    <Column width="10%" hAlign="Center" vAlign="Middle">
                        <Text text="{i18n>modificarcantidad}" />
                    </Column>
                    <Column width="8%" hAlign="Center" vAlign="Middle">
                        <Text text="" />
                    </Column>
                    <Column width="10%" hAlign="Center" vAlign="Middle">
                        <Text text="{i18n>ActionDelete}" visible="false" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{attribute}" />
                            <Input value="{path: 'value', formatter: '.formatter.getMaterial'}" enabled="false" />
                            <Input value="{path: 'value', formatter: '.formatter.getLote'}" enabled="false" />
                            <ObjectAttribute text="{loteQty} {loteUom}" />
                            <Input value="{path: 'value', formatter: '.formatter.getSecuencia'}" enabled="false" />
                            <Input value="{value}" enabled="false" visible="false"/>
                            <Input value="{cantidadAsignada}" enabled="true" type="Number" width="100px"/>
                            <Button icon="sap-icon://add" press=".onAddQty" tooltip="{i18n>modificarcantidad}"/>
                            <!-- <ndc:BarcodeScannerButton  
                                scanSuccess=".onScanSlotSuccess"
                                scanFail=".onScanError"
                                dialogTitle="{i18n>BarcodeScanner}"
                            /> -->
                            <Button icon="sap-icon://delete" press=".onDeleteSlot" type="Reject"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            </HBox>      
    </Panel>	
        
</mvc:View>